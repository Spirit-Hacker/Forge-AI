generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  password String

  projects Project[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  files     ProjectFile[]
  snapshots ProjectSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ProjectFile {
  id String @id @default(cuid())

  projectId String
  path      String

  objectKey String @unique

  size        Int
  contentType String?
  sha256      String

  currentVersionId String? @unique

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentVersion FileVersion? @relation("CurrentFileVersion", fields: [currentVersionId], references: [id])

  versions FileVersion[] @relation("FileVersions")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  snapshotFiles SnapshotFile[]

  @@unique([projectId, path])
  @@index([projectId])
}

model FileVersion {
  id String @id @default(cuid())

  fileId String

  version Int

  objectKey String

  size        Int
  contentType String?
  sha256      String

  file ProjectFile @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)

  currentForFile ProjectFile? @relation("CurrentFileVersion")

  createdAt     DateTime       @default(now())
  snapshotFiles SnapshotFile[]

  @@unique([fileId, version])
  @@index([fileId])
}

model Session {
  id     String @id @default(cuid())
  userId String

  refreshTokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProjectSnapshot {
  id String @id @default(cuid())

  projectId String
  name      String?
  message   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  files SnapshotFile[]

  createdAt DateTime @default(now())

  @@index([projectId])
}

model SnapshotFile {
  id String @id @default(cuid())

  snapshotId String
  fileId     String
  versionId  String

  snapshot ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  file ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  version FileVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, fileId])
  @@index([snapshotId])
}
